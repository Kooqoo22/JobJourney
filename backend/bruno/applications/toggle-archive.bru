meta {
  name: Toggle Archive Application
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/applications/1/archive
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "is_archived": true
  }
}

docs {
  ## Description
  Toggle the archived state of a job application. Send is_archived: true to archive, false to unarchive. Archived applications are hidden from the default list view (which uses is_archived=false filter).

  ## Responses
  ### 200 OK (archived)
  { "message": "application archived" }

  ### 200 OK (unarchived)
  { "message": "application unarchived" }

  ### 400 Bad Request
  { "message": "invalid request body" }

  ### 401 Unauthorized
  { "message": "missing authorization token" }

  ### 404 Not Found
  { "message": "application not found" }

  ### 500 Internal Server Error
  { "message": "internal server error" }
}
