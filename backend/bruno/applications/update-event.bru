meta {
  name: Update Event
  type: http
  seq: 11
}

put {
  url: {{baseUrl}}/applications/1/events/1
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  X-Timezone: {{timezone}}
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "title": "Technical Interview Round 2 - Updated",
    "notes": "Prepare system design and behavioral questions"
  }
}

docs {
  ## Description
  Update an event's details. Only provided fields are updated. Send empty string "" for notes or remind_at to clear them. Returns 404 if the event is not found or does not belong to the specified application and authenticated user.

  ## Responses
  ### 200 OK
  { "message": "event updated", "data": { "id": 1, "application_id": 1, "type": "interview", "title": "Technical Interview Round 2 - Updated", "event_at": "2026-07-15T10:00:00+07:00", "notes": "Prepare system design and behavioral questions", "remind_at": null, "status_from": null, "status_to": null, "created_at": "2026-07-09T12:00:00+07:00", "updated_at": "2026-07-09T13:00:00+07:00" } }

  ### 400 Bad Request
  { "message": "invalid request body" }

  ### 401 Unauthorized
  { "message": "missing authorization token" }

  ### 404 Not Found
  { "message": "event not found" }

  ### 422 Unprocessable Entity
  { "message": "validation failed", "errors": [ { "field": "remind_at", "message": "must be in the future" } ] }

  ### 500 Internal Server Error
  { "message": "internal server error" }
}
