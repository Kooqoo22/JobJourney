meta {
  name: Restore Application
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/applications/1/restore
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  ## Description
  Restore a soft-deleted application within the 30-day retention window. The application must have been deleted by the same user. Events and documents are not automatically restored.

  ## Responses
  ### 200 OK
  { "message": "application restored", "data": { "id": 1, "company_name": "Acme Corp", "position_title": "Backend Engineer", "status": "applied", "is_archived": false, "created_at": "2026-07-09T10:00:00+07:00", "updated_at": "2026-07-09T12:00:00+07:00" } }

  ### 401 Unauthorized
  { "message": "missing authorization token" }

  ### 404 Not Found
  { "message": "application not found" }

  ### 409 Conflict
  { "message": "application cannot be restored after the retention period" }

  ### 500 Internal Server Error
  { "message": "internal server error" }
}
