meta {
  name: Update Application
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/applications/1
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  X-Timezone: {{timezone}}
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "company_name": "Acme Corp Updated",
    "position_title": "Senior Backend Engineer",
    "status": "interview",
    "updated_at": "2026-07-09T10:00:00Z"
  }
}

docs {
  ## Description
  Update a job application. Only provided fields are updated. Includes optimistic concurrency protection via updated_at: supply the updated_at value from the most recent GET response. If the record was modified since then, a 409 is returned.

  Send an empty string "" for optional fields to clear them (e.g. "salary_min": "" clears the salary).

  ## Responses
  ### 200 OK
  { "message": "application updated", "data": { "id": 1, "company_name": "Acme Corp Updated", "position_title": "Senior Backend Engineer", "status": "interview", "is_archived": false, "created_at": "2026-07-09T10:00:00+07:00", "updated_at": "2026-07-09T11:00:00+07:00" } }

  ### 400 Bad Request
  { "message": "invalid request body" }

  ### 401 Unauthorized
  { "message": "missing authorization token" }

  ### 404 Not Found
  { "message": "application not found" }

  ### 409 Conflict
  { "message": "application was modified by another request, please refresh and retry" }

  ### 422 Unprocessable Entity
  { "message": "validation failed", "errors": [ { "field": "salary_min", "message": "must be less than or equal to salary_max" } ] }

  ### 500 Internal Server Error
  { "message": "internal server error" }
}
