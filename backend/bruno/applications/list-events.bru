meta {
  name: List Events
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/applications/1/events
  auth: bearer
}

headers {
  X-Timezone: {{timezone}}
}

auth:bearer {
  token: {{accessToken}}
}

params:query {
  cursor:
  limit: 50
}

docs {
  ## Description
  Get the chronological timeline of events for a job application. Events are sorted by event_at ASC, id ASC (oldest first). Returns 404 if the application does not belong to the authenticated user.

  ## Responses
  ### 200 OK
  { "message": "events retrieved", "data": [ { "id": 1, "application_id": 1, "type": "applied", "title": "Status changed to applied", "event_at": "2026-07-09T10:00:00+07:00", "notes": null, "remind_at": null, "status_from": null, "status_to": "applied", "created_at": "2026-07-09T10:00:00+07:00", "updated_at": "2026-07-09T10:00:00+07:00" } ], "meta": { "next_cursor": null, "has_next": false, "limit": 50 } }

  ### 401 Unauthorized
  { "message": "missing authorization token" }

  ### 404 Not Found
  { "message": "application not found" }

  ### 500 Internal Server Error
  { "message": "internal server error" }
}
