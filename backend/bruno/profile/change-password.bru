meta {
  name: Change Password
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/profile/password
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "current_password": "Password123",
    "new_password": "NewPass456"
  }
}

docs {
  ## Description
  Changes the password for local (email+password) accounts. Requires the current password. Google-only accounts cannot use this endpoint.

  ## Responses
  ### 200 OK
  { "message": "password changed successfully" }

  ### 400 Bad Request
  { "message": "invalid request body" }

  ### 401 Unauthorized
  { "message": "missing authorization token" }

  ### 401 Unauthorized
  { "message": "current password is incorrect" }

  ### 403 Forbidden
  { "message": "password cannot be changed for accounts that use Google sign-in" }

  ### 422 Unprocessable Entity
  { "message": "password does not meet the requirements", "errors": [ { "field": "new_password", "message": "must be at least 8 characters" } ] }

  ### 500 Internal Server Error
  { "message": "internal server error" }
}
